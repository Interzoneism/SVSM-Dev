<UserControl
    x:Class="VintageStoryModManager.Views.Dialogs.ModlistDetailsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:VintageStoryModManager.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="OverlayRoot"
    d:DesignHeight="720"
    d:DesignWidth="1400"
    Focusable="True"
    PreviewKeyDown="OverlayRoot_OnPreviewKeyDown"
    Visibility="Collapsed"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:StringToImageSourceConverter x:Key="ModlistImageSourceConverter" />
        <Style x:Key="ModlistPropertyCardStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="{DynamicResource Brush.Panel.Secondary.Background.Solid}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#99000000" MouseLeftButtonDown="Backdrop_OnMouseLeftButtonDown">
        <Border
            x:Name="DialogSurface"
            MinWidth="760"
            MinHeight="300"
            MaxWidth="1440"
            MaxHeight="900"
            Margin="58,42"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{DynamicResource Brush.Panel.Primary.Background.Solid}"
            BorderBrush="{DynamicResource Brush.Accent.Primary}"
            BorderThickness="1"
            CornerRadius="14"
            MouseLeftButtonDown="DialogSurface_OnMouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Opacity="0.72" ShadowDepth="8" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="24,18"
                    Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                    CornerRadius="14,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontSize="27"
                                FontWeight="Light"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                Text="{Binding Title, ElementName=OverlayRoot}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="13"
                                Foreground="{DynamicResource Brush.Text.Subtle}"
                                Text="{Binding Subtitle, ElementName=OverlayRoot}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Width="38"
                            Height="38"
                            Margin="18,0,0,0"
                            Click="CloseButton_OnClick"
                            Content="✕"
                            FontSize="18"
                            ToolTip="Close (Esc)" />
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" Margin="24,16,14,2">
                    <Border Style="{StaticResource ModlistPropertyCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Subtle}" Text="UPLOADER" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding Uploader, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModlistPropertyCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Subtle}" Text="MODLIST VERSION" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding ModlistVersion, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModlistPropertyCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Subtle}" Text="VINTAGE STORY" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding GameVersion, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModlistPropertyCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Subtle}" Text="MODS" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding ModCount, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModlistPropertyCardStyle}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Subtle}" Text="LAST UPDATED" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding DateDisplay, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ModlistPropertyCardStyle}" Visibility="{Binding OnlineOnlyVisibility, ElementName=OverlayRoot}">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Text.Subtle}" Text="SUBSCRIBERS" />
                            <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding SubscriberCount, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border
                    Grid.Row="2"
                    Margin="24,2,24,14"
                    Padding="14,10"
                    Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}"
                    CornerRadius="7">
                    <TextBlock
                        MaxHeight="72"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding Description, ElementName=OverlayRoot}"
                        TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="3" Margin="24,0,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="2,0,0,10"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.Text.Primary}"
                            Text="Mods in this modlist" />
                        <StackPanel Grid.Column="1" Margin="0,0,2,10" Orientation="Horizontal">
                            <ProgressBar
                                Width="110"
                                Height="4"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                IsIndeterminate="True"
                                Visibility="{Binding LoadingVisibility, ElementName=OverlayRoot}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource Brush.Text.Subtle}"
                                Text="{Binding LoadingMessage, ElementName=OverlayRoot}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Background="{DynamicResource Brush.ModBrowser.Background.Gradient}"
                        CornerRadius="10,10,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="10" ItemsSource="{Binding Mods, ElementName=OverlayRoot}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" ItemHeight="254" ItemWidth="274" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="258"
                                            Height="238"
                                            Margin="8"
                                            Background="{DynamicResource Brush.ModCard.NoThumb}"
                                            BorderBrush="{DynamicResource Brush.ModCard.Border.Gradient}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="ModCard_OnMouseLeftButtonUp"
                                            Tag="{Binding}">
                                            <Grid ClipToBounds="True">
                                                <Image
                                                    Source="/Resources/mod-default.png"
                                                    Stretch="UniformToFill"
                                                    Opacity="0.38" />
                                                <Image
                                                    Margin="0,0,0,78"
                                                    Source="{Binding LogoUrl, Converter={StaticResource ModlistImageSourceConverter}, IsAsync=True}"
                                                    Stretch="Uniform" />
                                                <Border
                                                    Height="82"
                                                    Padding="13,8"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource Brush.ModCard.InfoBox}"
                                                    CornerRadius="0,0,8,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock
                                                                FontSize="17"
                                                                FontWeight="Light"
                                                                Foreground="{DynamicResource Brush.Text.Primary}"
                                                                Text="{Binding Name}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding Name}" />
                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource Brush.Text.Subtle}"
                                                                Text="{Binding Author}"
                                                                TextTrimming="CharacterEllipsis" />
                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                FontSize="11"
                                                                Foreground="{DynamicResource Brush.Text.Subtle}"
                                                                Text="{Binding StatusText}"
                                                                TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="8,3,0,0">
                                                            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Brush.Text.Subtle}" Text="MODLIST VERSION" />
                                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding RequestedVersion}" />
                                                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Brush.Text.Subtle}" Text="{Binding DownloadsDisplay}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="4" Padding="24,14" Background="{DynamicResource Brush.Panel.Secondary.Background.Solid}" CornerRadius="0,0,14,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding OnlineOnlyVisibility, ElementName=OverlayRoot}">
                            <Button Margin="0,0,10,0" Padding="14,7" Click="HideModlistButton_OnClick" Content="Hide this modlist" />
                            <Button Padding="14,7" Click="HideAuthorButton_OnClick" Content="Hide all from this author" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Padding="22,7" Click="CloseButton_OnClick" Content="Close" IsDefault="True" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
